PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/arenacrmtest?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mock payment webhook (Phase 9); required in production if webhook route is enabled
MOCK_PAYMENT_WEBHOOK_SECRET=

# Phase 11 — optional auth tuning
# AUTH_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# REFRESH_TOKEN_TTL_MS=2592000000
# Never in production: PASSWORD_RESET_RETURN_TOKEN (returns reset token in JSON for tests only)

# Dev-only: accept POST /api/auth/verify-otp with code DEV_OTP_CODE (default 1234). Never enable in production.
# DEV_OTP_ENABLED=true
# DEV_OTP_CODE=1234

# Set to "false" to block POST /api/auth/coach-register (coach self-signup)
# ALLOW_COACH_SELF_REGISTER=false

# SMTP Email (for registration verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AMM Arena <your-email@gmail.com>"
FRONTEND_URL=https://www.ammarena.com

# Bank Muscat SmartPay (AMM SPORTS ARENA — MID 4115)
# Secrets stay on the backend only. Never put Working Key in VITE_* / React env.
BANK_MUSCAT_ENV=test
BANK_MUSCAT_MID=4115
BANK_MUSCAT_ACCESS_CODE=
BANK_MUSCAT_WORKING_KEY=
# aes-256-gcm = Bank Muscat "256 Bit" kit (default). aes-128-cbc = classic PHP Crypto.php kit.
BANK_MUSCAT_CRYPTO=aes-256-gcm
# UAT from Bank Muscat SmartPay kit email
BANK_MUSCAT_TEST_URL=https://spayuattrns.bmtest.om/transaction.do?command=initiateTransaction
# Set from Bank Muscat live credentials letter — do not invent
BANK_MUSCAT_PRODUCTION_URL=https://smartpaytrns.bankmuscat.com/transaction.do?command=initiateTransaction
# Public HTTPS API host Bank Muscat can POST to
BANK_MUSCAT_CALLBACK_URL=https://api.ammarena.com/api/payments/bank-muscat/callback
BANK_MUSCAT_RETURN_URL=https://www.ammarena.com/payment/bank-muscat/return
# Working key is 32 characters. Classic kit uses MD5(key)+AES-128-CBC (no separate IV env).
# Optional override — defaults are set from BANK_MUSCAT_ENV:
# UAT:  https://spayuatapi.bmtest.om/apis/servlet/DoWebTrans
# PROD: https://smartpayapi.bankmuscat.com/apis/servlet/DoWebTrans
# BANK_MUSCAT_STATUS_API_URL=
# BANK_MUSCAT_REFUND_API_URL=

# Public API base used to build callback if BANK_MUSCAT_CALLBACK_URL is unset
API_URL=https://api.ammarena.com

# Legacy aliases (still read if BANK_MUSCAT_* unset)
# CCAVENUE_MERCHANT_ID=4115
# CCAVENUE_ACCESS_CODE=
# CCAVENUE_WORKING_KEY=
# CCAVENUE_GATEWAY_URL=https://spayuatmars.bmtest.om/transaction/transaction.do

